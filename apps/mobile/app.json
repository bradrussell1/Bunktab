{
  "expo": {
    "name": "Checkm8",
    "slug": "checkm8",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "checkm8",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.check-m8.app",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSContactsUsageDescription": "Checkm8 reads your contacts on this device so you can pick who to invite. Only the numbers you choose are sent.",
        "NSCameraUsageDescription": "Checkm8 uses the camera to photograph receipts.",
        "NSPhotoLibraryUsageDescription": "Checkm8 uses your photos for receipts and trip covers.",
        "LSApplicationQueriesSchemes": [
          "venmo"
        ]
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.checkm8.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C0E12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "venmo"
            }
          ]
        }
      ],
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0E12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Checkm8 reads your contacts on this device so you can pick who to invite. Only the numbers you choose are sent."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Checkm8 uses your photos for receipts and trip covers.",
          "cameraPermission": "Checkm8 uses the camera to photograph receipts."
        }
      ],
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0C0E12",
    "owner": "brad.russell1",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
