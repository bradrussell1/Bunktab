{
  "expo": {
    "name": "Bunktab",
    "slug": "bunktab",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bunktab",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.bunktab.app",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSContactsUsageDescription": "Bunktab reads your contacts on this device so you can pick who to invite. Only the numbers you choose are sent.",
        "NSCameraUsageDescription": "Bunktab uses the camera to photograph receipts.",
        "NSPhotoLibraryUsageDescription": "Bunktab uses your photos for receipts and trip covers.",
        "LSApplicationQueriesSchemes": [
          "venmo"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "appleTeamId": "8LR5F2TH8L",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.bunktab.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "venmo"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Bunktab reads your contacts on this device so you can pick who to invite. Only the numbers you choose are sent."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bunktab uses your photos for receipts and trip covers.",
          "cameraPermission": "Bunktab uses the camera to photograph receipts."
        }
      ],
      "expo-notifications",
      "expo-sharing",
      "expo-apple-authentication",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F5F5F7",
    "owner": "brad.russell1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "652dbbb4-c619-44bb-80b2-df07159720cc"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/652dbbb4-c619-44bb-80b2-df07159720cc"
    }
  }
}
