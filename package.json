{
  "name": "zebrasplit",
  "private": true,
  "version": "0.1.0",
  "description": "Zebrasplit \u2014 split trip expenses, settle up in Venmo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspace=@bunktab/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mobile": "npm run start --workspace=mobile",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "smoke": "node scripts/smoke.mjs",
    "smoke:server": "node scripts/smoke-server.mjs",
    "web": "npm run dev --workspace=@bunktab/web",
    "site": "npm run dev --workspace=@bunktab/site"
  },
  "engines": {
    "node": ">=20"
  }
}
